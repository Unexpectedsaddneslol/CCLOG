// Prisma schema for Контр-Культура

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Investigation {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  body        String   @default("")
  coverImage  String
  pdfFile     String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Article {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String
  body       String   @default("")
  coverImage String
  pdfFile    String   @default("")
  order      Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  url         String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  shadow      String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  logo        String
  url         String   @default("")
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Follower {
  id          String   @id @default(cuid())
  name        String
  avatar      String
  telegramUrl String
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default("main")
  qrImage       String   @default("/assets/archive/qr.jpg")
  joinText      String   @default("")
  email         String   @default("dd1kfuckedthem@proton.me")
  telegramUrl   String   @default("")
  tiktokUrl     String   @default("")
  youtubeUrl    String   @default("")
  servicesContent String @default("")
  updatedAt     DateTime @updatedAt
}

model AdminSession {
  token     String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())
}

model VisitLog {
  id        String   @id @default(cuid())
  ip        String
  userAgent String   @default("")
  language  String   @default("")
  path      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
